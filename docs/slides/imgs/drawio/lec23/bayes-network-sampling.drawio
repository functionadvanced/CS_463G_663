        <mxCell id="reject" style="edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.7;entryX=0;entryY=0.5;strokeColor=#b8325f;strokeWidth=2.5;endArrow=block;endSize=6;" edge="1" source="draws" target="rejected" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
