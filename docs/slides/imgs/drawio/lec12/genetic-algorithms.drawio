<mxfile host="Electron" type="device">
  <diagram id="population-cycle" name="population-cycle">
    <mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="900" pageHeight="250" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="canvas" value="" style="html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=25;fontColor=#29333b;spacing=0;fillColor=#fff;strokeColor=none;strokeWidth=1.3;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="900" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="stage-0" value="Choose&#xa;parents" style="html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=26;fontColor=#29333b;spacing=0;fillColor=#e5f4f4;strokeColor=#007c89;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="25" y="42" width="178" height="94" as="geometry"/>
        </mxCell>
        <mxCell id="arrow-0" edge="1" parent="1" style="edgeStyle=none;strokeColor=#29333b;strokeWidth=2.4;endArrow=block;endSize=7;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="208" y="89" as="sourcePoint"/>
            <mxPoint x="241" y="89" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="stage-1" value="Crossover:&#xa;combine" style="html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=26;fontColor=#29333b;spacing=0;fillColor=#fcebf1;strokeColor=#b8325f;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="249" y="42" width="178" height="94" as="geometry"/>
        </mxCell>
        <mxCell id="arrow-1" edge="1" parent="1" style="edgeStyle=none;strokeColor=#29333b;strokeWidth=2.4;endArrow=block;endSize=7;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="432" y="89" as="sourcePoint"/>
            <mxPoint x="465" y="89" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="stage-2" value="Mutation:&#xa;change" style="html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=26;fontColor=#29333b;spacing=0;fillColor=#fff0cc;strokeColor=#a86b11;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="473" y="42" width="178" height="94" as="geometry"/>
        </mxCell>
        <mxCell id="arrow-2" edge="1" parent="1" style="edgeStyle=none;strokeColor=#29333b;strokeWidth=2.4;endArrow=block;endSize=7;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="656" y="89" as="sourcePoint"/>
            <mxPoint x="689" y="89" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="stage-3" value="Evaluate&#xa;offspring" style="html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=26;fontColor=#29333b;spacing=0;fillColor=#e5f4f4;strokeColor=#007c89;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="697" y="42" width="178" height="94" as="geometry"/>
        </mxCell>
        <mxCell id="loop-down" edge="1" parent="1" style="edgeStyle=none;strokeColor=#29333b;strokeWidth=2;endArrow=none;endSize=7;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="787" y="142" as="sourcePoint"/>
            <mxPoint x="787" y="190" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="loop-left" edge="1" parent="1" style="edgeStyle=none;strokeColor=#29333b;strokeWidth=2;endArrow=none;endSize=7;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="787" y="190" as="sourcePoint"/>
            <mxPoint x="114" y="190" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="loop-up" edge="1" parent="1" style="edgeStyle=none;strokeColor=#29333b;strokeWidth=2;endArrow=block;endSize=7;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="114" y="190" as="sourcePoint"/>
            <mxPoint x="114" y="142" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="replace" value="Replace the population: a new generation" style="text;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=25;fontColor=#007c89;spacing=0;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="180" y="202" width="545" height="37" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
